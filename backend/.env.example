# CivicFlow Backend Configuration
APP_NAME=CivicFlow
APP_ENV=development
API_PREFIX=/api
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database & Storage Paths (consumed from Member 4 / Member 2)
SQLITE_DB_PATH=backend/data/civicflow.db
ML_MODEL_PATH=backend/app/ml/model.pkl

# Decision Engine Weights (Configurable parameters from PRD Section 5.4)
PRIORITY_WEIGHT_RISK=0.50
PRIORITY_WEIGHT_URGENCY=0.25
PRIORITY_WEIGHT_IMPACT=0.25
